        }
    }
    
    private static double nhapSoThuc(String prompt) {
        VNCharacterUtils.printNoNewLine(prompt);
        try {
            return Double.parseDouble(scanner.nextLine());
        } catch (NumberFormatException e) {
            return 0;
        }
    }
}

// Account

package model;

import java.io.Serializable;

public abstract class Account implements Serializable {         // TỪ KHÓA 'abstract'
    protected String maTK;
    protected String chuTK;
    protected double soDu;
    
    public Account(String maTK, String chuTK, double soDu) {
        this.maTK = maTK;
        this.chuTK = chuTK;
        this.soDu = soDu;
    }
    
    // Abstract method - Đa hình
    public abstract String getLoaiTK();
    public abstract double tinhLaiSuat();
    
    // Getter/Setter
    public String getMaTK() { return maTK; }
    public String getChuTK() { return chuTK; }
    public double getSoDu() { return soDu; }
    public void setSoDu(double soDu) { this.soDu = soDu; }
    // Đa hình qua OVERRIDE
    @Override       // Khai báo trong lớp cha
    public String toString() {
        return String.format("Mã TK: %s, Chủ TK: %s, Loại: %s, Số dư: %.2f", 
            maTK, chuTK, getLoaiTK(), soDu);
    }
}

