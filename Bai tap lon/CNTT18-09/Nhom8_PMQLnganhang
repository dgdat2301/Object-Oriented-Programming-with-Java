//Collection framework (ArrayList, HashMap)
package service;

import model.Account;
import model.SavingsAccount;
import model.CheckingAccount;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public class AccountService {
    private BankService<Account> accountBankService;
    private Map<String, Account> accountMap;
    private TransactionService transactionService;
    
    public AccountService() {
        this.accountBankService = new BankService<>();
        // HashMap - tra cứu nhanh theo key
        this.accountMap = new HashMap<>();
        this.transactionService = new TransactionService();
    }
    
    // THÊM TÀI KHOẢN
    public void themTaiKhoan(Account account) {
        accountBankService.add(account);
        accountMap.put(account.getMaTK(), account);
        System.out.println("✅ Đã thêm tài khoản: " + account.getMaTK());
    }
    
    // SỬA THÔNG TIN TÀI KHOẢN
    public boolean suaTaiKhoan(String maTK, String tenMoi, double soDuMoi) {
        Account acc = timTheoMaTK(maTK);
        if (acc != null) {
            // Trong thực tế cần thêm setter cho tên chủ TK trong class Account
            // acc.setChuTK(tenMoi); // Cần thêm setter này trong class Account
            acc.setSoDu(soDuMoi);
            System.out.println("✅ Đã cập nhật tài khoản: " + maTK);
            return true;
        }
        System.out.println("❌ Không tìm thấy tài khoản để sửa!");
        return false;
    }
    
    // XÓA TÀI KHOẢN
    public void xoaTaiKhoan(String maTK) {
        Account acc = timTheoMaTK(maTK);
        if (acc != null) {
            accountBankService.remove(acc);
            accountMap.remove(maTK);
            System.out.println("✅ Đã xóa tài khoản: " + maTK);
        } else {
            System.out.println("❌ Không tìm thấy tài khoản!");
        }
    }
    
    // TÌM KIẾM
    public Account timTheoMaTK(String maTK) {
        return accountMap.get(maTK);
    }
    
    public List<Account> timTheoTenChuTK(String tenChuTK) {
        return accountBankService.search(acc -> 
            acc.getChuTK().toLowerCase().contains(tenChuTK.toLowerCase()));
    }
    
    // GIAO DỊCH CÓ GHI LỊCH SỬ
    public boolean napTien(String maTK, double soTien) {
        Account acc = timTheoMaTK(maTK);
        if (acc != null && soTien > 0) {
            acc.setSoDu(acc.getSoDu() + soTien);
            transactionService.themGiaoDich(maTK, "NẠP TIỀN", soTien, 
                "Nạp tiền vào tài khoản");
            System.out.printf("✅ Đã nạp %,.2f VND vào tài khoản %s\n", soTien, maTK);
            return true;
        }
        System.out.println("❌ Nạp tiền thất bại!");
        return false;
    }
    
    public boolean rutTien(String maTK, double soTien) {
        Account acc = timTheoMaTK(maTK);
        if (acc != null && soTien > 0 && acc.getSoDu() >= soTien) {
            acc.setSoDu(acc.getSoDu() - soTien);
            transactionService.themGiaoDich(maTK, "RÚT TIỀN", soTien, 
                "Rút tiền từ tài khoản");
            System.out.printf("✅ Đã rút %,.2f VND từ tài khoản %s\n", soTien, maTK);
            return true;
        }
        System.out.println("❌ Rút tiền thất bại! Số dư không đủ.");
        return false;
    }
    
    public boolean chuyenTien(String maTKNguon, String maTKDich, double soTien) {
        Account accNguon = timTheoMaTK(maTKNguon);
        Account accDich = timTheoMaTK(maTKDich);
        
        if (accNguon != null && accDich != null && soTien > 0 && accNguon.getSoDu() >= soTien) {
            accNguon.setSoDu(accNguon.getSoDu() - soTien);
            accDich.setSoDu(accDich.getSoDu() + soTien);
            
            // Ghi lịch sử cho cả 2 tài khoản
            transactionService.themGiaoDich(maTKNguon, "CHUYỂN TIỀN", -soTien, 
                "Chuyển tiền đến " + maTKDich);
            transactionService.themGiaoDich(maTKDich, "CHUYỂN TIỀN", soTien, 
                "Nhận tiền từ " + maTKNguon);
                
            System.out.printf("✅ Đã chuyển %,.2f VND từ %s sang %s\n", soTien, maTKNguon, maTKDich);
            return true;
        }
        System.out.println("❌ Chuyển tiền thất bại!");
        return false;
    }
    
    // THỐNG KÊ
    public double tinhSoDuTrungBinh() {
        if (accountBankService.isEmpty()) return 0;
        return accountBankService.getAll().stream()
                .mapToDouble(Account::getSoDu)
                .average()
                .orElse(0);
    }
    
    public long demKhachHangVIP(double nguongVIP) {
        return accountBankService.getAll().stream()
                .filter(acc -> acc.getSoDu() >= nguongVIP)
                .count();
    }
    
    // HIỂN THỊ
    public List<Account> getAllAccounts() {
        return accountBankService.getAll();
    }
    
    public void hienThiTatCaTaiKhoan() {
        List<Account> accounts = getAllAccounts();
        if (accounts.isEmpty()) {
            System.out.println("📭 Danh sách tài khoản trống!");
        } else {
