        List<Transaction> lichSu = getLichSuGiaoDich(maTK);
        if (lichSu.isEmpty()) {
            System.out.println("📭 Không có giao dịch nào cho tài khoản: " + maTK);
        } else {
            System.out.println("\n📋 LỊCH SỬ GIAO DỊCH - TK: " + maTK);
            lichSu.forEach(System.out::println);
        }
    }
    
