// SavingsAccount

package model;

public class SavingsAccount extends Account {
    private static final double LAI_SUAT = 0.05;
    
    public SavingsAccount(String maTK, String chuTK, double soDu) {
        super(maTK, chuTK, soDu);
    }
    
    @Override
    public String getLoaiTK() {         // Triển khai trong lớp con
        return "TIẾT KIỆM";
    }
    
    @Override
    public double tinhLaiSuat() {
        return soDu * LAI_SUAT;
    }
}

