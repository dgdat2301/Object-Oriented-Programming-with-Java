package model;

import java.io.Serializable;
import java.text.SimpleDateFormat;
import java.util.Date;

public class Transaction implements Serializable {
    private static final long serialVersionUID = 1L;
    private String maGD;
    private String maTK;
    private String loaiGD;
    private double soTien;
    private Date thoiGian;
    private String moTa;
    
    public Transaction(String maGD, String maTK, String loaiGD, double soTien, String moTa) {
        this.maGD = maGD;
        this.maTK = maTK;
        this.loaiGD = loaiGD;
        this.soTien = soTien;
        this.thoiGian = new Date();
        this.moTa = moTa;
    }
    
    public String getMaGD() { return maGD; }
    public String getMaTK() { return maTK; }
    public String getLoaiGD() { return loaiGD; }
    public double getSoTien() { return soTien; }
    public Date getThoiGian() { return thoiGian; }
    
    @Override
    public String toString() {
        SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
        return String.format("GD%s | TK: %s | %s | %,.2f VND | %s | %s",
            maGD, maTK, loaiGD, soTien, sdf.format(thoiGian), moTa);
    }
}

