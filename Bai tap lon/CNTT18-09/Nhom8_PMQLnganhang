// Lưu trữ dữ liệu ra file (Text hoặc Binary)
package utils;

import java.io.*;
import java.util.List;

public class FileManager {
    // GHI dữ liệu nhị phân
    public static <T> boolean luuDuLieu(List<T> data, String filename) {
        try (ObjectOutputStream oos = new ObjectOutputStream(
             new FileOutputStream("data/" + filename))) {
            oos.writeObject(data);
            System.out.println("💾 Đã lưu dữ liệu vào: data/" + filename);
            return true;
        } catch (IOException e) {
            System.err.println("❌ Lỗi lưu file: " + e.getMessage());
            return false;
        }
    }
    // ĐỌC dữ liệu nhị phân  
    @SuppressWarnings("unchecked")
    public static <T> List<T> docDuLieu(String filename) {
        File file = new File("data/" + filename);
        if (!file.exists()) {
            System.out.println("📁 File chưa tồn tại: " + filename);
            return new java.util.ArrayList<>();
        }
        
        try (ObjectInputStream ois = new ObjectInputStream(
             new FileInputStream("data/" + filename))) {
            List<T> data = (List<T>) ois.readObject();
            System.out.println("📖 Đã đọc dữ liệu từ: data/" + filename);
            return data;
        } catch (IOException | ClassNotFoundException e) {
            System.err.println("❌ Lỗi đọc file: " + e.getMessage());
            return new java.util.ArrayList<>();
        }
    }
    
    static {
        // Tạo thư mục data khi class được load
        new File("data").mkdirs();
    }
}

