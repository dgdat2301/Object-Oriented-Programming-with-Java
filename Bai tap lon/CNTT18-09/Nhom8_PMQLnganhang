package service;

import java.util.ArrayList;
import java.util.List;
import java.util.function.Predicate;
import java.util.stream.Collectors;

public class BankService<T> {           // <T> - Generic type parameter
    protected List<T> items;            // T có thể là Account, Customer, Transaction
    
    public BankService() {
        // ArrayList cho danh sách đối tượng
        this.items = new ArrayList<>();
    }
    
    public void add(T item) {           // Tham số kiểu T
        items.add(item);
    }
    
    public boolean remove(T item) {
        return items.remove(item);
    }
    
    public List<T> getAll() {           // Trả về kiểu List<T>
        return new ArrayList<>(items);
    }
    
    public T find(Predicate<T> predicate) {
        return items.stream().filter(predicate).findFirst().orElse(null);
    }
    
    public List<T> search(Predicate<T> predicate) {
        return items.stream().filter(predicate).collect(Collectors.toList());
    }
    
    public int size() {
        return items.size();
    }
    
    public void clear() {
        items.clear();
    }
    
    public boolean isEmpty() {
        return items.isEmpty();
    }
}

