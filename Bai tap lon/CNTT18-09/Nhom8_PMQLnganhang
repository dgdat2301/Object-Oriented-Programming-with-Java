                        accounts.forEach(System.out::println);
                    } else {
                        VNCharacterUtils.printError("Không tìm thấy tài khoản!");
                    }
                    break;
                case 3:
                    VNCharacterUtils.printNoNewLine("Nhập tên khách hàng cần tìm: ");
                    String tenKH = scanner.nextLine();
                    List<Customer> customers = customerService.timTheoTen(tenKH);
